---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import FallbackNotice from "@/components/FallbackNotice.astro";
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { counterpartUrl, getLangFromUrl } from "@/i18n/utils";
import { languages, type Lang } from "@/i18n/ui";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

// font families - extract font names for Font component (filter out type keys)
const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

// types for frontmatters
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  lang?: Lang;
  // true = EN body served under a non-EN URL (missing-translation fallback).
  isFallback?: boolean;
  // Locales that truly have this content. When given, hreflang alternates are
  // emitted only for these; omit for parity-guaranteed pages (home/about/etc.).
  translatedLangs?: Lang[];
}

// distructure frontmatters
const { title, meta_title, description, image, noindex, isFallback } =
  Astro.props;

// Page locale: explicit prop wins, else inferred from the URL.
const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);

// hreflang alternates. Default (parity-guaranteed pages): every locale. On a
// fallback page only the locales that truly have the content are advertised —
// emitting hreflang="de" for an EN body would be a false signal. Absolute URLs.
const hreflangLocales: Lang[] =
  Astro.props.translatedLangs ?? (Object.keys(languages) as Lang[]);
const alternates = hreflangLocales.map((code) => ({
  code,
  href: new URL(counterpartUrl(Astro.url, code), Astro.site).href,
}));
const xDefaultHref = new URL(counterpartUrl(Astro.url, "en"), Astro.site).href;

// Canonical: explicit prop wins; else on a fallback page point at the real EN
// URL so the DE URL is not indexed as duplicate EN content.
const canonical =
  Astro.props.canonical ??
  (isFallback
    ? new URL(counterpartUrl(Astro.url, "en"), Astro.site).href
    : undefined);
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- theme: set .dark before paint to avoid a flash (stored choice, else OS pref) -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const isDark = stored
            ? stored === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", isDark);
        } catch (e) {}
      })();
    </script>
    <!-- favicon -->
    <link rel="shortcut icon" href={config.site.favicon} />
    <!-- theme meta -->
    <meta name="theme-name" content="hydrogen-astro" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- google font css - Astro 6 built-in Font API -->
    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}` as any;
        return <Font cssVariable={cssVar} preload />;
      })
    }

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>
      {plainify(meta_title ? meta_title : title ? title : config.site.title)}
    </title>

    <!-- canonical url -->
    {canonical && <link rel="canonical" href={canonical} item-prop="url" />}

    <!-- hreflang alternates (EN/DE pair + x-default) -->
    {
      alternates.map(({ code, href }) => (
        <link rel="alternate" hreflang={code} href={href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta
      name="description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <ClientRouter />

    <!-- author from config.json -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- og-title -->
    <meta
      property="og:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- og-description -->
    <meta
      property="og:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content={`${config.site.base_url}/${Astro.url.pathname.replace("/", "")}`}
    />

    <!-- twitter-title -->
    <meta
      name="twitter:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- twitter-description -->
    <meta
      name="twitter:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <!-- og-image -->
    <meta
      property="og:image"
      content={`${config.site.base_url}${
        image ? image : config.metadata.meta_image
      }`}
    />

    <!-- twitter-image -->
    <meta
      name="twitter:image"
      content={`${config.site.base_url}${
        image ? image : config.metadata.meta_image
      }`}
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <TwSizeIndicator />
    <Header />
    <main id="main-content">
      {isFallback && <FallbackNotice lang={lang} />}
      <slot />
    </main>
    <Footer />
    <script>
      // Wire the header theme toggle. Runs on initial load and after each
      // view transition (ClientRouter swaps the header, so re-bind each time).
      function setupThemeToggle() {
        const btn = document.getElementById("theme-toggle");
        if (!btn) return;
        btn.addEventListener("click", () => {
          const isDark = document.documentElement.classList.toggle("dark");
          localStorage.setItem("theme", isDark ? "dark" : "light");
        });
      }
      document.addEventListener("astro:page-load", setupThemeToggle);

      // ClientRouter swaps the document on navigation, resetting the <html>
      // class. Re-apply the stored theme before paint after each swap so the
      // mode persists across pages (the is:inline head script only runs once).
      document.addEventListener("astro:after-swap", () => {
        const stored = localStorage.getItem("theme");
        const isDark = stored
          ? stored === "dark"
          : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", isDark);
      });
    </script>
  </body>
</html>
