---
import Base from "@/layouts/Base.astro";
import { entrySlug } from "@/i18n/content";
import { getLocalizedPagesWithFallback } from "@/lib/contentParser.astro";
import { render } from "astro:content";

// DE pages, prefixed under /de. EN counterparts in src/pages/[regular].astro.
// EN-superset driven: missing DE translations fall back to the EN body.
export async function getStaticPaths() {
  const entries = await getLocalizedPagesWithFallback("pages", "de");

  return entries.map(({ entry, isFallback, translatedLangs }) => ({
    params: { regular: entrySlug(entry.id) },
    props: { page: entry, isFallback, translatedLangs },
  }));
}

const { page, isFallback, translatedLangs } = Astro.props;
const { title, meta_title, description, image } = page.data;
const { Content } = await render(page);
---

<!-- Standalone pages lead with their own heading; no separate PageHeader hero. -->
<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  lang="de"
  isFallback={isFallback}
  translatedLangs={translatedLangs}
>
  <section class="section-sm">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-10">
          <div
            class="content [&>h1:first-child]:mt-0 [&>h1:first-child]:text-h2-sm md:[&>h1:first-child]:text-h1-page"
          >
            <Content />
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
