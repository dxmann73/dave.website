---
import Base from "@/layouts/Base.astro";
---

<Base title="Seite nicht gefunden" lang="de">
  <section class="section-sm text-center">
    <div class="container">
      <div class="row justify-center">
        <div class="sm:col-10 md:col-8 lg:col-6">
          <span class="text-[8rem] block font-bold text-text-dark"> 404 </span>
          <h1 class="h2 mb-4">Seite nicht gefunden</h1>
          <div class="content">
            <p>
              Die gesuchte Seite wurde möglicherweise entfernt, umbenannt oder
              ist vorübergehend nicht verfügbar.
            </p>
          </div>
          <a href="/de" class="btn btn-primary mt-8">Zurück zur Startseite</a>
        </div>
      </div>
    </div>
  </section>
</Base>
