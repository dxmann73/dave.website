---
import Base from "@/layouts/Base.astro";
import { getLocalizedPagesWithFallback } from "@/lib/contentParser.astro";
import { projectSlugParam } from "@/lib/utils/projectsLang";
import ProjectSingle from "@/partials/ProjectSingle.astro";

// DE projects, prefixed under /de. EN in src/pages/projects/[...slug].astro.
// EN-superset driven: missing DE translations fall back to the EN body.
export async function getStaticPaths() {
  const entries = await getLocalizedPagesWithFallback("projects", "de");
  return entries.map(({ entry, isFallback, translatedLangs }) => ({
    params: { slug: projectSlugParam(entry.id) },
    props: { project: entry, isFallback, translatedLangs },
  }));
}

const { project, isFallback, translatedLangs } = Astro.props;
const { title, summary } = project.data;
---

<Base
  title={title}
  description={summary}
  lang="de"
  isFallback={isFallback}
  translatedLangs={translatedLangs}
>
  <ProjectSingle project={project} />
</Base>
