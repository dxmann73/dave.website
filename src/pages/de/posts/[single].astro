---
import Base from "@/layouts/Base.astro";
import { entrySlug } from "@/i18n/content";
import { getLocalizedPagesWithFallback } from "@/lib/contentParser.astro";
import PostSingle from "@/partials/PostSingle.astro";

// DE posts, prefixed under /de. EN in src/pages/posts/[single].astro.
// EN-superset driven: missing DE translations fall back to the EN body.
export async function getStaticPaths() {
  const entries = await getLocalizedPagesWithFallback("posts", "de");

  return entries.map(({ entry, isFallback, translatedLangs }) => ({
    params: { single: entrySlug(entry.id) },
    props: { post: entry, isFallback, translatedLangs },
  }));
}

const { post, isFallback, translatedLangs } = Astro.props;
const { title, meta_title, description, image } = post.data;
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  lang="de"
  isFallback={isFallback}
  translatedLangs={translatedLangs}
>
  <PostSingle post={post} />
</Base>
