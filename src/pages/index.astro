---
import ImageMod from "@/components/ImageMod.astro";
import Social from "@/components/Social.astro";
import config from "@/config/config.json";
import social from "@/config/social.json";
import Base from "@/layouts/Base.astro";
import { mottos } from "@/lib/data/motto";
import { DEFAULT_LANG } from "@/lib/utils/projectsLang";
import { markdownify } from "@/lib/utils/textConverter";

const { name, image, designation, bio } = config.profile;
const motto = mottos[DEFAULT_LANG].items;
---

<Base>
  {/* profile */}
  <div class="section pt-8 xl:pt-12">
    <div class="container">
      <div class="row">
        <div class="mx-auto text-center lg:col-8">
          <ImageMod
            class="mx-auto h-[220px] w-[220px] rounded-full object-cover"
            src={image}
            width={440}
            height={440}
            alt={name}
            loading="eager"
            format="webp"
            fit="cover"
          />
          <h1
            set:html={markdownify(name)}
            class="mt-12 text-4xl lg:text-6xl font-semibold"
          />
          <p
            set:html={markdownify(designation)}
            class="mt-6 text-primary text-xl"
          />
          <p set:html={markdownify(bio)} class="mt-4 leading-9 text-xl" />

          {/* Mottos */}
          <div class="mt-4 flex flex-col items-center gap-3 sm:flex-row sm:flex-wrap sm:justify-center sm:gap-4">
            {motto.map((m, i) => (
              <>
                {i > 0 && <span class="hidden text-text/50 sm:inline">•</span>}
                <a
                  href={`/projects#${m.id}`}
                  class="text-lg italic text-text transition-colors hover:text-primary"
                >
                  {m.text}
                </a>
              </>
            ))}
          </div>

          <Social source={social.main} className="social-icons mt-8" />
        </div>
      </div>
    </div>
  </div>
</Base>
